@app.route('/api/procesar', methods=['POST'])
def api_procesar():
    import time
    inicio = time.time()
    try:
        archivos = request.files.getlist('archivos')
        if not archivos:
            return jsonify({"error": "No se recibieron archivos - Sube fotos, PDF, Excel, TXT"}), 400

