@app.route('/health')
def health():
    return jsonify({"celula":MANIFEST["codigo"],"status":"VIVA","puerto":MANIFEST["puerto"],"acumulable":True,"precio":MANIFEST["precio_mensual"]})

@app.route('/api/detectar')
def detectar():
    conn = sqlite3.connect(DB)
    df = pd.read_sql_query("SELECT * FROM empleados", conn)
    conn.close()
    dup = df[df.duplicated('cedula', keep=False)]
    hallazgos = [{"codigo":f"H-{ced}","descripcion":f"Cédula {ced} duplicada"} for ced in dup['cedula'].unique()]
    return jsonify({"celula":MANIFEST["codigo"],"manifest":MANIFEST,"hallazgos":hallazgos,"vive_sola":True,"puede_acumularse":True})

