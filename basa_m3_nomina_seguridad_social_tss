"""
M3: Auditoría de Nómina y Seguridad Social (TSS / DGII)
Procedimiento: FI-CI-PR-001
Base Legal: Ley 87-01 sobre Seguridad Social
"""
import sys, json, hashlib

def auditar_nomina(sueldo_bruto):
    sfs_emp = round(sueldo_bruto * 0.0304, 2)
    afp_emp = round(sueldo_bruto * 0.0287, 2)
    neto = round(sueldo_bruto - (sfs_emp + afp_emp), 2)
    return {
        "modulo": "M3",
        "sueldo_bruto": sueldo_bruto,
        "sfs_empleado_3_04": sfs_emp,
        "afp_empleado_2_87": afp_emp,
        "sueldo_neto": neto
    }

if __name__ == '__main__':
    print(json.dumps(auditar_nomina(85000), indent=2, ensure_ascii=False))
